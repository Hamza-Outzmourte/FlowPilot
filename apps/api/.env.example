# FlowPilot Backend Environment Variables
# Copy this to .env and fill in your values

# Application
APP_NAME=FlowPilot
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=postgresql+asyncpg://flowpilot:flowpilot@localhost:5432/flowpilot

# Redis (Celery + cache)
REDIS_URL=redis://localhost:6379/0

# Telegram (you add your bot token here)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# Google Gemini (you add your API key here)
GOOGLE_API_KEY=your-gemini-api-key

# CORS
CORS_ORIGINS=http://localhost:5173

# Webhook base URL (public URL for Telegram webhooks)
WEBHOOK_BASE_URL=http://localhost:8000
